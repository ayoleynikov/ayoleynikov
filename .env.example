# Application
PULSE_ENV=development
PULSE_DEBUG=true
PULSE_LOG_LEVEL=INFO
PULSE_API_HOST=0.0.0.0
PULSE_API_PORT=8000

# PostgreSQL
PULSE_POSTGRES_HOST=localhost
PULSE_POSTGRES_PORT=5432
PULSE_POSTGRES_USER=pulse
PULSE_POSTGRES_PASSWORD=pulse
PULSE_POSTGRES_DB=pulse

# Redis
PULSE_REDIS_URL=redis://localhost:6379/0

# ClickHouse (Phase 6 analytics)
PULSE_CLICKHOUSE_HOST=localhost
PULSE_CLICKHOUSE_PORT=8123
PULSE_CLICKHOUSE_USER=default
PULSE_CLICKHOUSE_PASSWORD=
PULSE_CLICKHOUSE_DB=pulse
PULSE_CLICKHOUSE_ENABLED=true

# S3-compatible object storage (stub)
PULSE_S3_ENDPOINT_URL=http://localhost:9000
PULSE_S3_ACCESS_KEY=minio
PULSE_S3_SECRET_KEY=minio123
PULSE_S3_BUCKET=pulse
PULSE_S3_REGION=us-east-1

# Auth (change in production)
PULSE_JWT_SECRET=change-me-in-production-use-a-long-random-string
PULSE_JWT_ALGORITHM=HS256
PULSE_JWT_EXPIRE_MINUTES=60

# RSS (Phase 2) — comma-separated public feed URLs for the poll worker
# Example: https://www.reddit.com/r/python/.rss is NOT used (Reddit gated).
# Use clearly public feeds you are permitted to poll.
PULSE_RSS_FEEDS=

# Bluesky Jetstream (Phase 3) — optional preferred region key:
# us-east-1 | us-east-2 | us-west-1 | us-west-2 | us-west-v2
PULSE_BLUESKY_REGION=

# Usage / cost (Phase 7)
# Pricing is operator-configured via /api/v1/usage/pricing or source_costs rows.
# Never treat fixture prices as verified third-party API list prices.
# POST /api/v1/usage/pricing/fixture loads synthetic demo rates for local use.

# Mastodon (Phase 8) — per-instance only; never federation-wide search
# PULSE_MASTODON_INSTANCE_URL=https://mastodon.social
# PULSE_MASTODON_ACCESS_TOKEN=
# PULSE_MASTODON_HASHTAG=

# YouTube Data API v3 (Phase 8) — quota-limited; never assume unlimited access
# PULSE_YOUTUBE_API_KEY=
# PULSE_YOUTUBE_DAILY_QUOTA_UNITS=10000

# Reddit remains disabled until commercial permission.

# Security (Phase 9)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PULSE_CREDENTIALS_ENCRYPTION_KEY=
# Comma-separated browser origins; empty = no CORS reflection (secure default)
PULSE_CORS_ALLOW_ORIGINS=
PULSE_CORS_ALLOW_CREDENTIALS=false
PULSE_API_RATE_LIMIT_ENABLED=true
PULSE_API_RATE_LIMIT_REQUESTS=120
PULSE_API_RATE_LIMIT_WINDOW_SECONDS=60
PULSE_SSRF_RESOLVE_DNS=true
